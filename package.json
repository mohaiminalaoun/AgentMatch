{
	"name": "agent-match",
	"version": "1.0.0",
	"description": "A network of personal AI agents that form teams on behalf of their humans.",
	"scripts": {
		"test": "vitest run",
		"start": "tsx src/index.ts",
		"typecheck": "tsc --noEmit",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"eval": "tsx src/evaluation/run.ts",
		"eval:agents": "tsx src/eval-agents.ts",
		"ask": "tsx src/ask.ts",
		"decide": "tsx src/decide.ts",
		"reliability": "tsx src/reliability.ts",
		"show-run": "tsx src/show-run.ts",
		"load-test": "tsx src/load-test.ts",
		"round": "tsx src/round.ts",
		"negotiate": "tsx src/negotiate.ts",
		"coevolve": "tsx src/coevolve.ts",
		"hunch": "tsx src/hunch.ts",
		"discover": "tsx src/discover.ts",
		"simulate": "tsx src/simulate.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohaiminalaoun/AgentMatch.git"
	},
	"keywords": [],
	"author": "",
	"license": "UNLICENSED",
	"bugs": {
		"url": "https://github.com/mohaiminalaoun/AgentMatch/issues"
	},
	"homepage": "https://github.com/mohaiminalaoun/AgentMatch#readme",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@types/node": "^22.20.5",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"zod": "^4.6.7"
	}
}

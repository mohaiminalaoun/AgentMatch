# Copy this file to .env and fill in your values. Never commit .env.

# OpenAI-compatible endpoint. The Meta Model API is https://api.meta.ai/v1.
LLM_BASE_URL=https://api.meta.ai/v1

# From the API keys page of your provider's dashboard.
LLM_API_KEY=replace-me

# The model ID on that provider, for example muse-spark-1.3 on the Meta Model API.
LLM_MODEL=replace-me

# Optional: requests in flight at once (default 8). Raise it if load tests see no 429s; lower it if they see many.
# LLM_MAX_CONCURRENCY=8

# Optional: how long the model thinks before answering: minimal, low, medium, or high (unset uses the
# provider's default). Hidden reasoning was 95% of output tokens in simulations; minimal is far faster.
# LLM_REASONING_EFFORT=minimal

# Optional: prices in US dollars per million tokens, from the provider's pricing page, so reports can
# estimate cost. Meta Model API prices on Oct 28, 2026:
#   muse-spark-1.3:              input 1.25, cached input 0.15, output 4.25
#   muse-spark-1.3-contributor:  input 0.10, cached input 0.002, output 0.20
# The contributor model is 95% cheaper because Meta trains on its inputs and outputs: use it only with
# synthetic profiles, never with real people's data.
# LLM_PRICE_INPUT=1.25
# LLM_PRICE_CACHED_INPUT=0.15
# LLM_PRICE_OUTPUT=4.25

# Optional: the hosted mailbox outside agents answer through (step 11.13; `npm run mailbox`).
# MAILBOX_URL=https://your-mailbox.vercel.app
# The engine's key for it; the same value is set as MAILBOX_ENGINE_KEY on the Vercel project.
# MAILBOX_ENGINE_KEY=replace-me

# Optional wake notification for --outside PERSON=grokbot (Bearer authentication).
# GROKBOT_WEBHOOK_URL=https://your-routine-webhook
# GROKBOT_WEBHOOK_KEY=replace-me
